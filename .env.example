PORT=4100
MUSIC_DIR=./data/music
MUSIC_LIB_SECRET=change-me-to-a-long-random-string
MAX_CACHE_SIZE_MB=2048
# MAX_UPLOAD_MB=512           # PUT /api/music/file/* 單檔上限

# 網頁播放器（選用）：Discord 登入設定好才會啟用 /player；不設定就完全關閉。任何 Discord 帳號都能登入
# Discord Developer Portal → OAuth2：Redirects 加上 <PUBLIC_BASE_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
PUBLIC_BASE_URL=https://music.example.com
# 管理員的 Discord 使用者 ID，逗號分隔：刪除／改名／上傳音樂、Bot 正在播放只有管理員能用
WEB_ADMIN_USERS=
# WEB_BLOCKED_USERS=          # 不能登入的使用者 ID（已登入的也立即失效）
# ALLOW_INSECURE_LIBRARY_API=1   # 沒設 MUSIC_LIB_SECRET 時 /api/music/* 預設停用（503）；設 1 才開放（只限完全信任的內網）
# WEB_SESSION_HOURS=720
# WEB_SESSION_SECRET=         # 不設定時自動產生隨機金鑰存在 data/session-secret（WEB_SESSION_SECRET_FILE 可改位置）
# TRUST_PROXY=loopback, linklocal, uniquelocal   # 只信任從本機／私有網段連進來的反向代理
# MUSIC_REQUIRE_VOLUME=0      # 正式環境的音樂庫沒有掛 Volume 時 /health 預設回 503；設 0 關閉這項檢查

# 網頁線上串流（YouTube / Bilibili，需要伺服器有 yt-dlp 與 ffmpeg；沒有會自動停用）
# WEB_ONLINE=0                # 設 0 可強制關閉線上串流
# WEB_MAX_STREAMS=4           # 同時即時串流上限
# WEB_MAX_STREAMS_PER_USER=2  # 一般帳號（非管理員）同時線上串流上限
# WEB_QUERIES_PER_MINUTE=30   # 一般帳號每分鐘搜尋／取得影片資訊次數上限
# WEB_MAX_DOWNLOADS=2         # 同時背景下載快取上限
# WEB_MAX_QUERIES=4           # 同時搜尋／取得影片資訊的 yt-dlp 上限（一次雙平台搜尋佔 2 個）
# WEB_MAX_NORMALIZE=2         # 同時響度正規化（ffmpeg）上限，背景下載與網頁上傳共用
# WARP_PROXY_URL=             # YouTube 走 Proxy（同 Bot）
# YOUTUBE_PO_TOKEN=           # 固定 PO Token（會過期，建議改用下面的 bgutil 自動產生器）
# POT_PROVIDER=0              # 關閉 bgutil PO Token 自動產生器（Docker 映像預設內建並自動啟動）
# POT_PROVIDER_URL=           # 改用外部 bgutil server，例如 http://bgutil:4416（設了就不啟動內建的）
# POT_IDLE_MINUTES=15         # 內建 bgutil server 按需啟動，閒置多久後關閉以釋放記憶體
# BGUTIL_SERVER_DIR=          # 內建 bgutil server 位置，預設 /opt/bgutil/server
# YTDLP_COOKIES_DIR=          # cookies.txt / www.youtube.com_cookies.txt 所在資料夾，預設 ./data（Docker 內為 /app/data）
# BILIBILI_SESSDATA= / BILIBILI_BILI_JCT= / BILIBILI_DEDEUSERID=
# LOG_DEBUG=1
# LOG_TIMESTAMPS=0           # 關閉 log 前面的 ISO 時間（部署平台本身已經會加時間時）

# 告警（未設定就不送）
# ALERT_WEBHOOK_URL=          # Discord webhook：網頁串流一小時內失敗達 5 次、播放器登入失敗太多次時通知
# ALERT_NAME=music-library    # 告警訊息開頭的名稱

# yt-dlp 自動更新（預設只在 NODE_ENV=production，也就是 Docker 映像內開啟）
# YTDLP_AUTO_UPDATE=1         # 1＝強制開啟、0＝關閉
# YTDLP_UPDATE_HOURS=24       # 檢查間隔（小時）

# 播放清單 JSON 檔位置（預設 ./data/playlists.json，Docker 內為 /app/data/playlists.json；Volume 請掛在 /app/data）
# PLAYLISTS_FILE=
